# Prototype runs without environment variables. Optional beta auth foundation:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never place secret/service-role keys in NEXT_PUBLIC_* variables.

# Private website operator access (retained local Admin UI only, no Supabase role).
# Leave unset to keep Admin unavailable. Set securely on the server; never NEXT_PUBLIC_.
SERVIFY_ADMIN_USERNAME=
# SHA-256 hex digest of an independently generated high-entropy operator password.
SERVIFY_ADMIN_PASSWORD_SHA256=
# Use HTTPS for network access or loopback-only local review. Do not reuse account passwords.
