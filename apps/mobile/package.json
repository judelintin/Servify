{
  "name": "servify-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8081",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "export:web": "expo export --platform web",
    "verify:domain": "node scripts/verify-domain.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "export:all": "expo export --platform all",
    "verify:requests": "node scripts/verify-requests.mjs",
    "verify:requests-browser": "node scripts/verify-requests-browser.mjs",
    "verify:professional": "node scripts/verify-professional.mjs",
    "verify:professional-browser": "node scripts/verify-professional-browser.mjs",
    "verify:marketplace": "node scripts/verify-marketplace.mjs",
    "verify:marketplace-browser": "node scripts/verify-marketplace-browser.mjs",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "verify:delivery-browser": "node scripts/verify-delivery-browser.mjs",
    "verify:trust": "node scripts/verify-trust.mjs",
    "verify:trust-browser": "node scripts/verify-trust-browser.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
