{
  "expo": {
    "name": "Servify",
    "slug": "servify",
    "version": "0.1.0",
    "scheme": "servify-preview",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Servify Mobile Preview",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Servify to select photographs for your local service request.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "1799c1ab-db36-4eb8-a421-9009642c625b"
      }
    },
    "owner": "kodlins-team"
  }
}
